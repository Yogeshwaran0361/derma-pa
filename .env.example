# DermaVision AI - Patient Frontend Environment Variables Template
# Copy this file to .env or add these key-value pairs in your Vercel Project Settings -> Environment Variables

# FastAPI Production Backend URL (e.g. https://your-backend.render.com/api)
VITE_API_URL=

# Firebase Client Web Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# EmailJS Client Credentials
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
